digraph F {
  graph [rankdir=TB, dpi=200, fontname="Inter", nodesep=0.4, ranksep=0.4, pad=0.3];
  node [shape=box, style="rounded,filled", fontname="Inter", fontsize=11, fillcolor="#FFFDF8", color="#c9c2b0", penwidth=1.3];
  edge [color="#7b857f", fontname="Inter", fontsize=9.5, fontcolor="#4b564f"];
  in [label="Mensaje (WhatsApp o chat web)", fillcolor="#e7f2dc", color="#3e7b4f"];
  id [label="¿Remitente registrado y\nmódulo M5 activo?", shape=diamond, style=filled, fillcolor="#ffffff"];
  san [label="Sanitizar entrada\n(control, largo 800)"];
  pend [label="¿Es SI / NO y hay\nacción pendiente?", shape=diamond, style=filled, fillcolor="#ffffff"];
  dosis [label="Guardrail: ¿pide dosis,\nproducto o mezcla?", shape=diamond, style=filled, fillcolor="#fbe4e1", color="#c0392b"];
  rech [label="RECHAZADO\n\"No recomiendo dosis…\"", fillcolor="#fbe4e1", color="#c0392b"];
  inter [label="Interpretar: LLM (Claude/Groq)\n→ validar JSON · lista blanca\n(si falla: intérprete por reglas)", fillcolor="#e1eef6", color="#2e6f95"];
  falt [label="¿Faltan datos?", shape=diamond, style=filled, fillcolor="#ffffff"];
  pide [label="FALTAN_DATOS\npide parcela / producto…"];
  prop [label="Crear AccionPendiente (10 min)\nResponder resumen + \"¿Confirmas?\"", fillcolor="#fdf1dc", color="#d68910"];
  ej [label="Ejecutar en BD (Prisma)\n+ auditoría", fillcolor="#1F3A2B", fontcolor="white", color="#1F3A2B"];
  ok [label="REGISTRADO ✓", fillcolor="#e7f2dc", color="#3e7b4f"];
  can [label="CANCELADO\nno se guarda nada"];
  err [label="ERROR controlado\n(p. ej. parcela no existe)"];
  in -> id; id -> san [label="sí"]; id -> rech2 [label="no"];
  rech2 [label="Respuesta informativa"];
  san -> pend; pend -> ej [label="SI"]; pend -> can [label="NO"]; pend -> dosis [label="otro texto"];
  dosis -> rech [label="sí"]; dosis -> inter [label="no"];
  inter -> falt; falt -> pide [label="sí"]; falt -> prop [label="no"];
  prop -> pend [style=dashed, label="siguiente\nmensaje"];
  ej -> ok [label="éxito"]; ej -> err [label="falla"];
}
