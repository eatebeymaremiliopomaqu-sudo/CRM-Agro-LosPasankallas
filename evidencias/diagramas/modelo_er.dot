digraph ER { graph [rankdir=LR, dpi=200, fontname="Inter", nodesep=0.35, ranksep=0.8, pad=0.3]; node [shape=plain, fontname="Inter"]; edge [color="#7b857f", arrowhead=crow, arrowtail=tee, dir=both, penwidth=1.2];
