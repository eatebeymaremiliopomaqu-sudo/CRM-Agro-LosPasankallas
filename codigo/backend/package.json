{
  "name": "crm-agro-backend",
  "version": "1.0.0",
  "description": "API REST del CRM-Agro: control técnico de campo, trazabilidad y gestión de trabajadores para fincas pequeñas",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:int": "vitest run tests/integracion",
    "lint": "node --check src/server.js",
    "start:render": "prisma db push --skip-generate && node prisma/seed-si-vacio.js && node src/server.js",
    "test:unit": "vitest run tests/unit"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "supertest": "^7.0.0",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.21.5": true
  }
}
