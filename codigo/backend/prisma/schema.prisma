// CRM-Agro · Modelo de datos (SQLite + Prisma)
// Convención: nombres en español, ids autoincrementales, fechas en UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────────── M0 · Núcleo ─────────────
model Finca {
  id             Int      @id @default(autoincrement())
  nombre         String
  municipio      String?
  departamento   String?
  lat            Float?
  lng            Float?
  hectareas      Float    @default(0)
  whatsappActivo Boolean  @default(false)
  telefonoWa     String?
  // Alertas automáticas por WhatsApp (hora local de Bolivia, UTC-4)
  alertasActivas Boolean  @default(true)
  horaAlertas    String   @default("07:00")
  creadoEn       DateTime @default(now())

  usuarios     Usuario[]
  modulos      ModuloFinca[]
  lotes        Lote[]
  trabajadores Trabajador[]
  insumos      Insumo[]
  productos    ProductoCosechado[]
  clientes     Cliente[]
  mensajes     MensajeWhatsApp[]
  acciones     AccionPendiente[]
  alertas      BitacoraAlerta[]
  lotesPlantin LotePlantin[]
}

model ModuloFinca {
  id       Int      @id @default(autoincrement())
  fincaId  Int
  finca    Finca    @relation(fields: [fincaId], references: [id])
  codigo   String // M1, M2, M3, M4, M5, M6, M7
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now())

  @@unique([fincaId, codigo])
}

model Usuario {
  id                     Int         @id @default(autoincrement())
  nombre                 String
  email                  String      @unique
  passwordHash           String
  // PROPIETARIO | ENCARGADO | TRABAJADOR
  rol                    String      @default("TRABAJADOR")
  telefono               String?
  // Consentimiento para recibir alertas automáticas por WhatsApp (ALTA/BAJA)
  consentimientoWhatsapp Boolean     @default(false)
  fechaConsentimiento    DateTime?
  trabajadorId           Int?
  trabajador             Trabajador? @relation(fields: [trabajadorId], references: [id])
  activo                 Boolean     @default(true)
  fincaId                Int
  finca                  Finca       @relation(fields: [fincaId], references: [id])
  creadoEn               DateTime    @default(now())

  labores         Labor[]
  auditorias      Auditoria[]
  tareasAsignadas Tarea[]     @relation("TareasAsignadas")
}

model Auditoria {
  id        Int      @id @default(autoincrement())
  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
  fincaId   Int?
  accion    String // CREAR | ACTUALIZAR | ELIMINAR | LOGIN | AGENTE
  entidad   String
  entidadId Int?
  detalle   String?
  fecha     DateTime @default(now())
}

// ───────────── M0 · Lotes y cultivos (antes M1) ─────────────
model Lote {
  id        Int     @id @default(autoincrement())
  fincaId   Int
  finca     Finca   @relation(fields: [fincaId], references: [id])
  codigo    String
  nombre    String
  areaHa    Float
  lat       Float?
  lng       Float?
  tipoSuelo String?
  riego     String? // GOTEO | ASPERSION | GRAVEDAD | SECANO
  activa    Boolean @default(true)

  campanias          Campania[]
  labores            Labor[]
  observaciones      Observacion[]
  asistencias        Asistencia[]
  laboresProgramadas LaborProgramada[]
  tareas             Tarea[]

  @@unique([fincaId, codigo])
}

model Campania {
  id              Int       @id @default(autoincrement())
  loteId          Int
  lote            Lote      @relation(fields: [loteId], references: [id])
  cultivo         String
  variedad        String?
  fechaSiembra    DateTime
  fechaCosechaEst DateTime?
  estado          String    @default("EN_CURSO") // EN_CURSO | COSECHADA | PERDIDA

  labores      Labor[]
  lotesCosecha LoteCosecha[]
}

// Labor programada (calendario)
model LaborProgramada {
  id               Int         @id @default(autoincrement())
  loteId           Int
  lote             Lote        @relation(fields: [loteId], references: [id])
  tipo             String // RIEGO | FERTILIZACION | FUMIGACION | DESHIERBE | PODA | MONITOREO | OTRA
  fechaProgramada  DateTime
  responsableId    Int?
  responsable      Trabajador? @relation(fields: [responsableId], references: [id])
  estado           String      @default("PENDIENTE") // PENDIENTE | HECHA | CANCELADA
  descripcion      String?
  laborRealizadaId Int?        @unique
  laborRealizada   Labor?      @relation(fields: [laborRealizadaId], references: [id])
  creadoEn         DateTime    @default(now())
}

// ───────────── M1 · Control técnico de campo ─────────────
model Labor {
  id              Int         @id @default(autoincrement())
  loteId          Int
  lote            Lote        @relation(fields: [loteId], references: [id])
  campaniaId      Int?
  campania        Campania?   @relation(fields: [campaniaId], references: [id])
  // SIEMBRA | RIEGO | FERTILIZACION | FUMIGACION | DESHIERBE | PODA | COSECHA | MONITOREO | OTRA
  tipo            String
  fecha           DateTime    @default(now())
  descripcion     String?
  horas           Float       @default(0)
  costoBs         Float       @default(0)
  trabajadorId    Int?
  trabajador      Trabajador? @relation(fields: [trabajadorId], references: [id])
  origen          String      @default("WEB") // WEB | WHATSAPP | AGENTE | OFFLINE
  registradoPorId Int?
  registradoPor   Usuario?    @relation(fields: [registradoPorId], references: [id])

  aplicacion   Aplicacion?
  programacion LaborProgramada?
}

// Registro (no recomendación) de una aplicación de agroquímico,
// tal como la indicó el técnico responsable.
model Aplicacion {
  id                  Int     @id @default(autoincrement())
  laborId             Int     @unique
  labor               Labor   @relation(fields: [laborId], references: [id], onDelete: Cascade)
  producto            String
  motivo              String? // plaga/enfermedad objetivo
  dosisEtiqueta       String? // dosis registrada de la etiqueta (texto)
  ingredienteActivo   String?
  cantidadUsada       Float?
  unidad              String?
  periodoCarenciaDias Int?
  responsableTecnico  String
  // Insumo del inventario usado (descuenta stock y valoriza el costo en M7)
  insumoId            Int?
  insumo              Insumo? @relation(fields: [insumoId], references: [id])
}

model Observacion {
  id        Int      @id @default(autoincrement())
  loteId    Int
  lote      Lote     @relation(fields: [loteId], references: [id])
  tipo      String // PLAGA | ENFERMEDAD | CLIMA | SUELO | OTRO
  severidad Int      @default(1) // 1 a 5
  nota      String
  fecha     DateTime @default(now())
  origen    String   @default("WEB")
}

// ───────────── M2 · Trazabilidad ─────────────
model LoteCosecha {
  id           Int      @id @default(autoincrement())
  codigo       String   @unique // p. ej. FSR-2026-0007
  campaniaId   Int
  campania     Campania @relation(fields: [campaniaId], references: [id])
  fechaCosecha DateTime
  cantidadKg   Float
  calidad      String   @default("PRIMERA") // PRIMERA | SEGUNDA | DESCARTE
  destino      String?
  tokenPublico String   @unique
  creadoEn     DateTime @default(now())

  eventos       EventoTrazabilidad[]
  detallesVenta DetalleVenta[]
}

model EventoTrazabilidad {
  id      Int         @id @default(autoincrement())
  loteId  Int
  lote    LoteCosecha @relation(fields: [loteId], references: [id], onDelete: Cascade)
  tipo    String // COSECHA | ACOPIO | LAVADO | EMPAQUE | DESPACHO | VENTA
  fecha   DateTime    @default(now())
  detalle String?
}

// ───────────── M3 · Trabajadores ─────────────
model Trabajador {
  id                     Int       @id @default(autoincrement())
  fincaId                Int
  finca                  Finca     @relation(fields: [fincaId], references: [id])
  nombre                 String
  documento              String?
  telefono               String?
  cargo                  String    @default("JORNALERO")
  jornalBs               Float     @default(100)
  consentimientoWhatsapp Boolean   @default(false)
  fechaConsentimiento    DateTime?
  activo                 Boolean   @default(true)
  creadoEn               DateTime  @default(now())

  usuarios           Usuario[]
  asistencias        Asistencia[]
  pagos              Pago[]
  labores            Labor[]
  laboresProgramadas LaborProgramada[]
  tareas             Tarea[]
}

model Asistencia {
  id           Int        @id @default(autoincrement())
  trabajadorId Int
  trabajador   Trabajador @relation(fields: [trabajadorId], references: [id])
  fecha        DateTime
  horas        Float      @default(8)
  tarea        String?
  loteId       Int?
  lote         Lote?      @relation(fields: [loteId], references: [id])
  origen       String     @default("WEB")

  @@unique([trabajadorId, fecha])
}

model Pago {
  id           Int        @id @default(autoincrement())
  trabajadorId Int
  trabajador   Trabajador @relation(fields: [trabajadorId], references: [id])
  desde        DateTime
  hasta        DateTime
  dias         Float
  montoBs      Float
  estado       String     @default("PENDIENTE") // PENDIENTE | PAGADO
  creadoEn     DateTime   @default(now())
}

model Tarea {
  id               Int        @id @default(autoincrement())
  trabajadorId     Int
  trabajador       Trabajador @relation(fields: [trabajadorId], references: [id])
  asignadoPorId    Int
  asignadoPor      Usuario    @relation("TareasAsignadas", fields: [asignadoPorId], references: [id])
  titulo           String
  descripcion      String?
  loteId           Int?
  lote             Lote?      @relation(fields: [loteId], references: [id])
  prioridad        String     @default("MEDIA") // BAJA | MEDIA | ALTA | URGENTE
  estado           String     @default("PENDIENTE") // PENDIENTE | EN_CURSO | COMPLETADA | CANCELADA
  fechaAsignacion  DateTime   @default(now())
  fechaVencimiento DateTime?
  fechaCompletada  DateTime?
  notificada       Boolean    @default(false)
  creadoEn         DateTime   @default(now())
}

// ───────────── M4 · Inventario de insumos ─────────────
model Insumo {
  id          Int    @id @default(autoincrement())
  fincaId     Int
  finca       Finca  @relation(fields: [fincaId], references: [id])
  nombre      String
  categoria   String // SEMILLA | FERTILIZANTE | AGROQUIMICO | HERRAMIENTA | OTRO
  unidad      String
  stock       Float  @default(0)
  stockMinimo Float  @default(0)
  costoUnitBs Float  @default(0)

  movimientos  MovimientoInsumo[]
  aplicaciones Aplicacion[]
}

model MovimientoInsumo {
  id       Int      @id @default(autoincrement())
  insumoId Int
  insumo   Insumo   @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  tipo     String // ENTRADA | SALIDA
  cantidad Float
  motivo   String?
  fecha    DateTime @default(now())
}

// ───────────── M4 · Inventario de productos cosechados ─────────────
model ProductoCosechado {
  id            Int      @id @default(autoincrement())
  fincaId       Int
  finca         Finca    @relation(fields: [fincaId], references: [id])
  nombre        String // Tomate Cherry, Lechuga Crespa, etc.
  cultivo       String // TOMATE, LECHUGA, etc.
  unidad        String // kg, unidad, bandeja
  stock         Float    @default(0)
  stockMinimo   Float    @default(0)
  precioVentaBs Float    @default(0)
  creadoEn      DateTime @default(now())

  movimientos MovimientoProducto[]
}

model MovimientoProducto {
  id         Int               @id @default(autoincrement())
  productoId Int
  producto   ProductoCosechado @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tipo       String // ENTRADA | SALIDA
  cantidad   Float
  motivo     String? // COSECHA | VENTA | MERMA | AJUSTE
  referencia String? // ID del lote de cosecha o venta
  fecha      DateTime          @default(now())
}

// ───────────── M5 · Ventas y clientes ─────────────
model Cliente {
  id                     Int       @id @default(autoincrement())
  fincaId                Int
  finca                  Finca     @relation(fields: [fincaId], references: [id])
  nombre                 String
  tipo                   String    @default("MINORISTA") // MINORISTA | MAYORISTA | RESTAURANTE | MERCADO
  telefono               String?
  consentimientoWhatsapp Boolean   @default(false)
  fechaConsentimiento    DateTime?
  nit                    String?
  direccion              String?
  activo                 Boolean   @default(true)
  creadoEn               DateTime  @default(now())

  pedidos Pedido[]
  ventas  Venta[]
}

model Pedido {
  id           Int       @id @default(autoincrement())
  clienteId    Int
  cliente      Cliente   @relation(fields: [clienteId], references: [id])
  fecha        DateTime  @default(now())
  fechaEntrega DateTime?
  estado       String    @default("PENDIENTE") // PENDIENTE | CONFIRMADO | ENTREGADO | CANCELADO
  origen       String    @default("WEB") // WEB | WHATSAPP
  total        Float     @default(0)
  notas        String?
  creadoEn     DateTime  @default(now())

  detalles DetallePedido[]
}

model DetallePedido {
  id       Int    @id @default(autoincrement())
  pedidoId Int
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto String // nombre del producto
  cantidad Float
  unidad   String
  precioBs Float
  subtotal Float
}

model Venta {
  id        Int      @id @default(autoincrement())
  clienteId Int
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  fecha     DateTime @default(now())
  total     Float
  pagado    Float    @default(0)
  saldo     Float    @default(0)
  estado    String   @default("PENDIENTE") // PENDIENTE | PAGADO | VENCIDO
  notas     String?
  creadoEn  DateTime @default(now())

  detalles DetalleVenta[]
  cobros   Cobro[]
}

model DetalleVenta {
  id            Int          @id @default(autoincrement())
  ventaId       Int
  venta         Venta        @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto      String // nombre del producto
  cantidad      Float
  unidad        String
  precioBs      Float
  subtotal      Float
  loteCosechaId Int?
  loteCosecha   LoteCosecha? @relation(fields: [loteCosechaId], references: [id])
  // M6: venta de plantines del vivero
  lotePlantinId Int?
  lotePlantin   LotePlantin? @relation(fields: [lotePlantinId], references: [id])
}

model Cobro {
  id      Int      @id @default(autoincrement())
  ventaId Int
  venta   Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  fecha   DateTime @default(now())
  montoBs Float
  metodo  String   @default("EFECTIVO") // EFECTIVO | TRANSFERENCIA | QR
  recibo  String?
}

// ───────────── M6 · Vivero (producción de plantines) ─────────────
model LotePlantin {
  id                Int       @id @default(autoincrement())
  fincaId           Int
  finca             Finca     @relation(fields: [fincaId], references: [id])
  codigo            String // VIV-2026-01
  especie           String // Tomate, Lechuga, Frutilla…
  variedad          String?
  fechaSiembra      DateTime
  bandejas          Int       @default(1)
  semillasSembradas Int
  germinadas        Int       @default(0)
  merma             Int       @default(0) // plantines perdidos después de germinar
  vendidos          Int       @default(0)
  etapa             String    @default("SIEMBRA") // SIEMBRA | GERMINACION | CRECIMIENTO | LISTO | AGOTADO
  precioBs          Float     @default(0) // por plantín
  costoBs           Float     @default(0) // costo total de producción (semilla, sustrato, bandejas)
  fechaListo        DateTime?
  notas             String?
  creadoEn          DateTime  @default(now())

  detallesVenta DetalleVenta[]

  @@unique([fincaId, codigo])
}

// ───────────── Capacidad transversal · WhatsApp + agente de IA ─────────────
model MensajeWhatsApp {
  id        Int      @id @default(autoincrement())
  fincaId   Int
  finca     Finca    @relation(fields: [fincaId], references: [id])
  telefono  String
  direccion String // ENTRANTE | SALIENTE
  texto     String
  fecha     DateTime @default(now())
}

// Bitácora de alertas automáticas enviadas (riego, labores, stock, carencia, cobros)
model BitacoraAlerta {
  id           Int      @id @default(autoincrement())
  fincaId      Int
  finca        Finca    @relation(fields: [fincaId], references: [id])
  tipo         String // RESUMEN_DIARIO
  disparo      String // PROGRAMADO | MANUAL
  destinatario String // nombre (rol)
  telefono     String
  mensaje      String
  cantidad     Int      @default(0) // número de avisos incluidos
  estado       String // ENVIADO | SIMULADO | FALLIDO
  error        String?
  fecha        DateTime @default(now())
}

model AccionPendiente {
  id        Int      @id @default(autoincrement())
  fincaId   Int
  finca     Finca    @relation(fields: [fincaId], references: [id])
  canal     String // WHATSAPP | WEB
  remitente String // teléfono o "usuario:<id>"
  tipo      String // REGISTRAR_LABOR | REGISTRAR_ASISTENCIA | REGISTRAR_OBSERVACION | REGISTRAR_COSECHA | MARCAR_TAREA_HECHA | PEDIDO_CLIENTE
  payload   String // JSON
  resumen   String
  estado    String   @default("PENDIENTE") // PENDIENTE | CONFIRMADA | CANCELADA | EXPIRADA
  expiraEn  DateTime
  creadoEn  DateTime @default(now())
}
