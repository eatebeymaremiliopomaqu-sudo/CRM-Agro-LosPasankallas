# Copiar a .env y completar. NUNCA subir .env al repositorio.
PORT=3000
NODE_ENV=development
DATABASE_URL="file:./dev.db"

# Seguridad
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
# URL pública del frontend (para armar el enlace del código QR)
FRONTEND_URL=http://localhost:5173

# Agente de IA: proveedor "claude", "groq" o "reglas" (sin LLM, modo offline)
AI_PROVIDER=reglas
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ── WhatsApp ──
# Proveedor: twilio | meta | simulado (sin credenciales = simulado, los mensajes quedan en la bitácora)
WHATSAPP_PROVIDER=simulado
# Celular real del usuario ENCARGADO para la demo (lo usa npm run db:seed). Vacío = número ficticio 59170000002
DEMO_WHATSAPP_ENCARGADO=

# Twilio (recomendado para la demo: Sandbox gratuito). Ver codigo/docs/WHATSAPP_TWILIO.md
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# URL pública exacta que pegaste en Twilio (ej. https://xxxx.trycloudflare.com/api/webhooks/twilio)
TWILIO_WEBHOOK_URL=
# Solo para pruebas locales sin túnel: false desactiva la validación de X-Twilio-Signature
TWILIO_VALIDAR_FIRMA=true

# Meta WhatsApp Cloud API. Ver codigo/docs/WHATSAPP_META.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=crm-agro-verify
WHATSAPP_APP_SECRET=
# Versión de la Graph API de Meta (las versiones antiguas se retiran)
WHATSAPP_GRAPH_VERSION=v24.0

# Alertas automáticas diarias (hora configurable por finca en la app)
ALERTAS_ACTIVAS=true
ZONA_HORARIA_MIN=-240
