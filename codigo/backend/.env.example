# Copiar a .env y completar. NUNCA subir .env al repositorio.
PORT=3000
NODE_ENV=development
DATABASE_URL="file:./dev.db"

# Seguridad
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
# URL pública del frontend (para armar el enlace del código QR)
FRONTEND_URL=http://localhost:5173

# Agente de IA: proveedor "claude", "groq" o "reglas" (sin LLM, modo offline)
AI_PROVIDER=reglas
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# WhatsApp Cloud API (Meta). Si se dejan vacíos, el envío queda en modo simulado.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=crm-agro-verify
WHATSAPP_APP_SECRET=
